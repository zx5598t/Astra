static func line(npc_id: String, key: String, params: Dictionary = {}, pick: float = 0.0) -> String:
    var pool: Array = LINES.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = MORE.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = MORE2.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = RECORD_OTHER.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = HEARSAY_LINES.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = SHIELD_LINES.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = ANALYST_LINES.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = LINK_LINES.get(npc_id, {}).get(key, [])
    if pool.is_empty():
        pool = LAST_LINES.get(npc_id, {}).get(key, [])
    var template := ""
    if pool.is_empty():
        template = str(FALLBACK.get(key, ""))
    else:
        template = str(pool[int(clampf(pick, 0.0, 0.999) * pool.size()) % pool.size()])
    if template == "":
        return ""
    return AstraJosa.fill(template, params)

static func has_line(npc_id: String, key: String) -> bool:
    return not Array(LINES.get(npc_id, {}).get(key, [])).is_empty() or not Array(MORE.get(npc_id, {}).get(key, [])).is_empty()

# Why an innocent lied, in their own words: the fixed personal secret from
# AstraCrewCatalog, framed by the kind of reason this Day's packet gave them.
const REASON_LEAD := {
    "EMBARRASSMENT": "창피해서 말을 돌렸어요.",
    "PROTECT_OTHER": "누군가를 감싸려고 했어요.",
    "HIDE_MISTAKE": "제 실수를 감추고 싶었어요.",
    "KEEP_PROMISE": "누군가와 한 약속이 있었어요.",
    "PERSONAL_SECRET": "사건과는 상관없는 제 일이에요.",
    "FEAR": "무서워서 제대로 말을 못 했어요.",
    "MISREMEMBERED": "착각이었어요."
}

static func secret(npc_id: String, reason: String, _pos: String) -> String:
    var base := str(AstraCrewCatalog.info(npc_id).get("secret", ""))
    var lead := str(REASON_LEAD.get(reason, ""))
    if npc_id in ["rho", "dax", "sena", "eli"]:
        lead = lead.replace("했어요", "했어").replace("있었어요", "있었어").replace("싶었어요", "싶었어").replace("이에요", "이야").replace("었어요", "었어").replace("에요", "야")
    return (lead + " " + base).strip_edges()

