static func isolated_line(npc_id: String, state: String, friend_name: String = "") -> String:
    var table: Dictionary = ISOLATED_STATE_LINES.get(npc_id, {})
    var text := str(table.get(state, table.get("resigned", "…")))
    return AstraJosa.fill(text, {"friend": friend_name})

